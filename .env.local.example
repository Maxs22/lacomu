# Supabase — Configuracion -> API, en el proyecto de Supabase.
# Copiar este archivo a .env.local y completar con los valores reales.
# .env.local NUNCA se commitea (ya esta en .gitignore por defecto de Next.js).

# URL del proyecto de Supabase. Publico, se expone al browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key. Publico, se expone al browser. Queda sujeto a las politicas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. NUNCA exponer al browser, NUNCA usar el prefijo NEXT_PUBLIC_.
# Solo para uso server-side puntual (tareas administrativas que deben saltarse RLS).
# No se usa en el scaffold inicial - documentado para cuando haga falta.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Developers -> tu aplicacion (modelo Marketplace/OAuth).
# Client ID y Client Secret de la APLICACION, no de una cuenta vendedora.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Mercado Pago Developers -> tu app -> Webhooks -> "Secret Key" (NO es
# MP_CLIENT_SECRET). Se usa para validar el header x-signature del webhook.
MP_WEBHOOK_SECRET=

# Dominio canonico para back_urls/notification_url/redirect_uri de MP.
# Sin esto, se usa el origin del request (sirve para dev). En produccion
# conviene setearlo (ej. https://lacomu.ar) para no depender del Host.
NEXT_PUBLIC_APP_URL=
